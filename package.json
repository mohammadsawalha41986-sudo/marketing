{
  "name": "restaurant-marketing-os",
  "version": "1.0.0",
  "description": "Private restaurant marketing management system for a single marketing operator.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "postinstall": "prisma generate",
    "build": "npm run prisma:verify && npm run build -w web && npm run build -w server",
    "prisma:verify": "node scripts/verify-prisma-engine.mjs",
    "start": "node --v8-pool-size=2 server/dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:library": "PRISMA_CLIENT_ENGINE_TYPE=library prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test -w server",
    "test:web": "npm run test -w web",
    "verify": "npm run typecheck && npm run test && npm run build",
    "owner:create": "node scripts/create-owner.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1"
  },
  "type": "module"
}
