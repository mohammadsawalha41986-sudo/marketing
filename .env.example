# Marketing OS — environment configuration.
# Copy to `.env` and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------- core
NODE_ENV=production
PORT=3000

# PostgreSQL connection string.
# Hostinger: take this from hPanel → Databases → PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/marketing_os?schema=public

# Signing secret for sessions. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# How long a login lasts, in hours.
SESSION_TTL_HOURS=168

# Public URL of the deployed app.
APP_URL=https://your-domain.com
# Comma-separated origins allowed to call the API with cookies.
# In production this is normally just APP_URL. In local dev, the Vite server.
CORS_ORIGIN=https://your-domain.com
# Set true when serving over HTTPS so session cookies carry the Secure flag.
COOKIE_SECURE=true

# ---------------------------------------------------------------- ai
# Optional. Without it the app uses its built-in template generator and every
# AI result is labelled in the UI as coming from the fallback engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- storage
# `local` writes to disk. Add a driver in server/src/services/storage to change this.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- limits
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
# Number of proxy hops in front of the app. Hostinger terminates TLS: keep 1.
TRUST_PROXY=1

# ---------------------------------------------------------------- integrations
# None of the ad-platform adapters are implemented yet. These are the variables
# each will need; setting them alone does not enable an integration.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_REDIRECT_URI=
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# SNAPCHAT_REDIRECT_URI=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_REDIRECT_URI=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=
