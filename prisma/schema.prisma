// Restaurant Marketing OS — data model.
//
// One owner (the marketing operator) runs one workspace containing many
// restaurants. Restaurants are SERVICE CLIENTS, not application users: they have
// no accounts, no logins and no portal. Every row below therefore hangs off a
// `restaurantId` and nothing else — there is no tenancy column, because there is
// no second tenant.

generator client {
  provider = "prisma-client-js"

  // Run the query engine as a child process instead of loading it into Node.
  //
  // The library engine loads the Rust engine into the Node process and starts a
  // tokio runtime there. On constrained shared hosting that spawn fails and the
  // engine panics with "PANIC: timer has gone away" — measured here, the Node
  // process holds 15 threads with the library engine and 7 with the binary one,
  // because the engine's threads move into their own process.
  //
  // Pinned in the schema rather than left to PRISMA_CLIENT_ENGINE_TYPE because
  // the engine type is baked in when the client is generated: relying on the
  // variable would mean relying on the host exporting it during `npm install`,
  // and if it does not, generation silently produces the wrong engine. The
  // variable still overrides this value, so setting
  // PRISMA_CLIENT_ENGINE_TYPE=library reverts to the library engine with no
  // code change. `npm run build` verifies what was actually generated.
  engineType = "binary"

  // Engines to emit at generate time. `native` covers the machine that runs
  // `prisma generate`; `debian-openssl-3.0.x` covers the Railway runtime image,
  // whose builder and runner can differ. Both are evidence-based — extra
  // targets would only add download weight.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// One human uses this application. The enum exists so the column keeps a
/// meaningful type rather than becoming a bare boolean.
enum Role {
  OWNER
}

enum RestaurantStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Language {
  AR
  EN
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  SNAPCHAT
  GOOGLE_ADS
  GOOGLE_BUSINESS
  X
  LINKEDIN
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  SALES
  APP_INSTALLS
  VIDEO_VIEWS
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ContentType {
  POST
  STORY
  REEL
  CAROUSEL
  AD_CREATIVE
  VIDEO
  ARTICLE
  EMAIL
}

/// The operator's own production pipeline. There is no approval state: the
/// operator both makes and ships the work.
enum ContentStatus {
  IDEA
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  LOGO
}

enum BrandAssetKind {
  LOGO
  LOGO_DARK
  ICON
  COVER
  PALETTE
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  CAMPAIGN_CREATED
  CAMPAIGN_ENDING
  BUDGET_WARNING
  CONTENT_SCHEDULED
  CONTENT_PUBLISHED
  PUBLISH_FAILED
  TASK_DUE
  INTEGRATION_DISCONNECTED
  REPORT_READY
  AI_ALERT
}

enum ReportType {
  RESTAURANT
  CAMPAIGN
  MONTHLY
  PLATFORM
}

enum AiKind {
  CONTENT
  HASHTAGS
  ANALYSIS
  BRAND
}

// ---------------------------------------------------------------- workspace & owner

/// Application settings, as a single row. `id` is pinned to a constant by the
/// application so a second workspace cannot be created by accident.
model Workspace {
  id             String   @id @default("workspace")
  name           String   @default("Restaurant Marketing OS")
  /// Default currency for budgets, spend and reports. SAR for the Gulf market.
  currency       String   @default("SAR")
  timezone       String   @default("Asia/Riyadh")
  locale         Language @default(EN)
  logoUrl        String?
  /// Operator-facing preferences that do not deserve their own column yet.
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// The marketing operator. In practice exactly one row; the application refuses
/// to create a second through the API and there is no public registration.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(OWNER)
  locale       Language  @default(EN)
  themePref    String    @default("dark")
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdContents Content[]      @relation("ContentAuthor")
  tasks           Task[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- restaurants & brand

/// A restaurant the operator markets for. Not an application user.
model Restaurant {
  id                   String           @id @default(cuid())
  name                 String           @unique
  businessName         String
  email                String?
  phone                String?
  cuisine              String?
  description          String?
  website              String?
  location             String?
  address              String?
  /// Branch names or addresses. A restaurant chain markets as one client.
  branches             String[]         @default([])
  /// Free-text marketing objectives agreed with the restaurant.
  marketingObjectives  String[]         @default([])
  notes                String?
  logoUrl              String?
  coverUrl             String?
  /// Google Business profile details, when the operator manages one.
  googleBusiness       Json             @default("{}")
  status               RestaurantStatus @default(ACTIVE)
  socialLinks          Json             @default("{}")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  brand         Brand?
  campaigns     Campaign[]
  contents      Content[]
  ads           Ad[]
  media         Media[]
  reports       Report[]
  tasks         Task[]
  notifications Notification[]
  integrations  Integration[]
  snapshots     AnalyticsSnapshot[]
  aiUsages      AiUsage[]

  @@index([status])
}

/// Brand DNA — the bounded context handed to the AI service on every generation.
model Brand {
  id                String   @id @default(cuid())
  restaurantId      String   @unique
  businessName      String
  cuisine           String?
  description       String?
  targetAudience    String?
  location          String?
  personality       String[] @default([])
  toneOfVoice       String?
  values            String[] @default([])
  products          String[] @default([])
  services          String[] @default([])
  usps              String[] @default([])
  offers            String[] @default([])
  keywords          String[] @default([])
  forbiddenWords    String[] @default([])
  ctaStyle          String?
  visualStyle       String?
  preferredLanguage Language @default(EN)
  // Approved identity. Colors are hex strings; the extractor only ever suggests.
  primaryColor      String   @default("#6366F1")
  secondaryColor    String   @default("#8B5CF6")
  accentColor       String   @default("#22D3EE")
  backgroundColor   String   @default("#0B0F1A")
  textColor         String   @default("#E8EBF2")
  fontFamily        String   @default("Inter")
  headingFont       String?
  bodyFont          String?
  logoUrl           String?
  logoDarkUrl       String?
  /// Unapproved palette suggested from the uploaded logo, pending review.
  suggestedPalette  Json?
  paletteApproved   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assets     BrandAsset[]
}

model BrandAsset {
  id        String         @id @default(cuid())
  brandId   String
  kind      BrandAssetKind
  url       String
  meta      Json           @default("{}")
  createdAt DateTime       @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

// ---------------------------------------------------------------- media

model Media {
  id           String    @id @default(cuid())
  restaurantId String?
  campaignId   String?
  type         MediaType
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  thumbnailUrl String?
  category     String?
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentLinks ContentMedia[]
  adCreatives  Ad[]           @relation("AdCreative")

  @@index([restaurantId])
  @@index([campaignId])
  @@index([type])
}

// ---------------------------------------------------------------- campaigns

model Campaign {
  id             String            @id @default(cuid())
  restaurantId   String
  name           String
  objective      CampaignObjective @default(AWARENESS)
  status         CampaignStatus    @default(PLANNING)
  budget         Decimal           @db.Decimal(12, 2)
  spend          Decimal           @default(0) @db.Decimal(12, 2)
  currency       String            @default("SAR")
  startDate      DateTime
  endDate        DateTime
  targetAudience String?
  locations      String[]          @default([])
  kpi            String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  platforms  CampaignPlatform[]
  contents   Content[]
  ads        Ad[]
  media      Media[]
  snapshots  AnalyticsSnapshot[]
  reports    Report[]
  tasks      Task[]

  @@index([restaurantId])
  @@index([status])
  @@index([startDate, endDate])
}

model CampaignPlatform {
  id         String   @id @default(cuid())
  campaignId String
  platform   Platform
  budget     Decimal  @default(0) @db.Decimal(12, 2)
  externalId String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, platform])
  @@index([campaignId])
}

// ---------------------------------------------------------------- ads

/// A single ad inside a campaign.
///
/// Metrics are entered by the operator from the ad platform's own reporting.
/// Nothing here is fetched automatically — the ad-platform adapters are
/// architecture only (see services/integrations) and would report 501. Ratios
/// (CTR, CPC, CPM, ROAS) are never stored: they are derived on read from these
/// figures, so a stored rate can never disagree with its own inputs.
model Ad {
  id           String    @id @default(cuid())
  restaurantId String
  campaignId   String
  name         String
  platform     Platform
  objective    CampaignObjective @default(AWARENESS)
  status       AdStatus  @default(DRAFT)
  headline     String?
  primaryText  String?
  cta          String?
  audience     String?
  creativeId   String?
  budget       Decimal   @default(0) @db.Decimal(12, 2)
  spend        Decimal   @default(0) @db.Decimal(12, 2)
  impressions  Int       @default(0)
  reach        Int       @default(0)
  clicks       Int       @default(0)
  leads        Int       @default(0)
  conversions  Int       @default(0)
  revenue      Decimal   @default(0) @db.Decimal(12, 2)
  /// Null until the operator first records figures, which is what lets the UI
  /// distinguish "no spend" from "not entered yet" instead of showing zeroes.
  metricsAt    DateTime?
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative   Media?     @relation("AdCreative", fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([campaignId])
  @@index([status])
  @@index([platform])
}

// ---------------------------------------------------------------- content

model Content {
  id             String        @id @default(cuid())
  restaurantId   String
  campaignId     String?
  authorId       String?
  name           String
  type           ContentType   @default(POST)
  status         ContentStatus @default(IDEA)
  platform       Platform
  language       Language      @default(EN)
  tone           String?
  productService String?
  offer          String?
  audience       String?
  /// Creative brief the operator writes before generating or drafting copy.
  brief          String?
  notes          String?
  // Generated or hand-written copy. Every field is editable by the user.
  headline       String?
  caption        String?
  primaryText    String?
  shortText      String?
  longText       String?
  slogan         String?
  cta            String?
  scheduledAt    DateTime?
  timezone       String        @default("Asia/Riyadh")
  publishedAt    DateTime?
  failureReason  String?
  aiGenerated    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  author        User?            @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  variants      ContentVariant[]
  hashtags      Hashtag[]
  mediaLinks    ContentMedia[]
  calendarEvent CalendarEvent?

  @@index([restaurantId])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@index([type])
}

model ContentVariant {
  id        String   @id @default(cuid())
  contentId String
  label     String
  language  Language @default(EN)
  headline  String?
  caption   String?
  body      String?
  cta       String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model Hashtag {
  id        String   @id @default(cuid())
  contentId String
  tag       String
  source    String   @default("ai")
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, tag])
  @@index([contentId])
}

model ContentMedia {
  contentId String
  mediaId   String
  position  Int     @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaId])
  @@index([mediaId])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  restaurantId String
  contentId    String   @unique
  title        String
  platform     Platform
  startAt      DateTime
  timezone     String   @default("Asia/Riyadh")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([startAt])
}

// ---------------------------------------------------------------- tasks

/// Operator to-do items. A task may hang off a restaurant and a campaign, or
/// stand alone as general workspace work.
model Task {
  id           String       @id @default(cuid())
  restaurantId String?
  campaignId   String?
  assigneeId   String?
  title        String
  details      String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignee   User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([status])
  @@index([dueAt])
}

// ---------------------------------------------------------------- analytics

/// One row per restaurant/campaign/platform/day. All dashboard numbers read
/// from here plus the Ad table.
model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  restaurantId String
  campaignId   String?
  platform     Platform
  date         DateTime @db.Date
  spend        Decimal  @default(0) @db.Decimal(12, 2)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  leads        Int      @default(0)
  conversions  Int      @default(0)
  revenue      Decimal  @default(0) @db.Decimal(12, 2)
  engagements  Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, platform, date])
  @@index([restaurantId, date])
  @@index([date])
}

// ---------------------------------------------------------------- reports

model Report {
  id           String     @id @default(cuid())
  restaurantId String
  campaignId   String?
  type         ReportType @default(RESTAURANT)
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  /// Rendered figures and AI insights, frozen at generation time.
  payload      Json
  createdAt    DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([type])
}

// ---------------------------------------------------------------- notifications

model Notification {
  id           String           @id @default(cuid())
  restaurantId String?
  userId       String?
  type         NotificationType
  title        String
  body         String?
  link         String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([restaurantId])
}

// ---------------------------------------------------------------- integrations

model Integration {
  id           String            @id @default(cuid())
  restaurantId String
  platform     Platform
  status       IntegrationStatus @default(DISCONNECTED)
  accountName  String?
  accountId    String?
  scopes       String[]          @default([])
  lastSyncAt   DateTime?
  lastError    String?
  /// Provider credentials. Never returned by the API.
  credentials  Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, platform])
}

// ---------------------------------------------------------------- observability

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

model AiUsage {
  id           String   @id @default(cuid())
  restaurantId String?
  kind         AiKind
  model        String
  provider     String   @default("template")
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([restaurantId])
}
