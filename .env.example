# Restaurant Marketing OS — environment configuration
#
# This file is DOCUMENTATION. It is committed on purpose and contains no
# secrets. Copy it to `.env` for local development.
#
# In production you do NOT need a .env file. Set these as service variables on
# the host (Railway: your service → Variables). The application reads
# process.env directly.
#
# Only two variables are required for the process to start:
#   DATABASE_URL
#   SESSION_SECRET
# Everything else has a working default or enables an optional feature.


# ==============================================================================
# REQUIRED — the server refuses to start without these
# ==============================================================================

# PostgreSQL connection string.
# On Railway, add a PostgreSQL database to the project and set this to the
# reference ${{Postgres.DATABASE_URL}} so it resolves over the private network.
# Any hosted PostgreSQL works; most external providers need ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Connections this process may open. Prisma's own default is cpus * 2 + 1, which
# on a shared host is derived from the whole machine's CPU count and is far too
# large. A connection_limit inside DATABASE_URL always wins over this.
# DATABASE_CONNECTION_LIMIT=5

# Signing secret for sessions. At least 32 characters. Never commit the real one.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=


# ==============================================================================
# CORE — sensible defaults, override when the deployment needs it
# ==============================================================================

# `production` on a live deployment.
NODE_ENV=production

# The host injects this. Do not set it on Railway.
# Default: 3000
# PORT=3000

# Public URL of the deployed app, used for links and as the default CORS origin.
# Leave unset on Railway: it is derived from the injected RAILWAY_PUBLIC_DOMAIN.
# Set it explicitly when serving from a custom domain.
# APP_URL=https://your-domain.com

# Comma-separated origins allowed to call the API with cookies.
# Leave unset: the front end and API are same-origin in production, so this
# defaults to APP_URL and CORS is not involved at all.
# CORS_ORIGIN=https://your-domain.com

# Secure flag on session cookies.
# Leave unset: on in production, off in development — which is what you want.
# Set to false ONLY if the site is genuinely served over plain HTTP; otherwise
# the browser drops the cookie and login silently fails.
# COOKIE_SECURE=true

# How long a login lasts, in hours. Default: 168 (7 days)
# SESSION_TTL_HOURS=168

# Number of proxy hops in front of the app. Railway terminates TLS, so 1.
# Affects secure-cookie detection, client IP, and rate limiting.
TRUST_PROXY=1


# ==============================================================================
# STORAGE
# ==============================================================================

# `local` writes to disk. Add a driver in server/src/services/storage to change.
# STORAGE_DRIVER=local

# Upload directory, relative to the repository root.
#
# ON RAILWAY THIS NEEDS A VOLUME. The container filesystem is replaced on every
# deploy, so without one, uploaded logos and media disappear at the next push.
# Attach a volume mounted at /app/storage and leave this at its default.
STORAGE_LOCAL_DIR=./storage/uploads

# Per-file upload limit in megabytes. Default: 25
# MAX_UPLOAD_MB=25


# ==============================================================================
# RATE LIMITING
# ==============================================================================

# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=300


# ==============================================================================
# OPTIONAL FEATURES — absence never prevents startup
# ==============================================================================

# AI content generation.
# Without a key the built-in template engine writes the copy and every result is
# labelled "Built-in engine" in the UI. With a key, the same endpoints call the
# model instead. The key stays server-side and never reaches the browser.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# ==============================================================================
# AD PLATFORM INTEGRATIONS — architecture only, not yet implemented
# ==============================================================================
#
# Setting these does NOT enable an integration on its own. Each adapter still
# needs implementing; until then every connect attempt returns HTTP 501 naming
# what is missing, rather than reporting a connection that does not exist.
# Ad performance figures are entered by hand in the Ads section meanwhile.
# The application starts and runs normally with all of them unset.

# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=

# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_REDIRECT_URI=

# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# SNAPCHAT_REDIRECT_URI=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_REDIRECT_URI=

# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=

# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=


# ==============================================================================
# OWNER ACCOUNT
# ==============================================================================
#
# There is no public registration. Create the single owner account with:
#   npm run owner:create -- --email you@example.com --name "Your Name"
#
# The script reads the password from OWNER_PASSWORD, or prompts with echo off.
# Never pass a password as a command-line argument: argv is visible to every
# other process on the machine and is written to shell history.
# OWNER_PASSWORD=
